{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "compile",
			"type": "shell",
			"command": "make",
			"options": {
				"cwd": "${workspaceRoot}",
				"env": {
					"PATH": "${env:PATH}:${command:amiga.bin-path}/opt/bin:${command:amiga.bin-path}"
				}
			},
			"args": [
				"-j4",
				"program=${config:amiga.program}"
			],
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "dist",
			"type": "shell",
			"command": "make",
			"options": {
				"cwd": "${workspaceRoot}",
				"env": {
					"PATH": "${env:PATH}:${command:amiga.bin-path}/opt/bin:${command:amiga.bin-path}"
				}
			},
			"args": [
				"-j4",
				"BUILD=dist"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			}
		},
		{
			"label": "clean",
			"type": "shell",
			"command": "make",
			"options": {
				"cwd": "${workspaceRoot}",
				"env": {
					"PATH": "${env:PATH}:${command:amiga.bin-path}/opt/bin:${command:amiga.bin-path}"
				}
			},
			"args": [
				"clean"
			],
			"problemMatcher": []
		}
	]
}